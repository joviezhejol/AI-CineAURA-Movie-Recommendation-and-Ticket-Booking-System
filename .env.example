# Environment Configuration for AI CineAura

# Server Port (Render sets this dynamically)
PORT=5005

# Environment (development | production)
NODE_ENV=development

# PostgreSQL Connection String (Neon, Supabase, Render PostgreSQL, etc.)
# Format: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Secret for authentication tokens (Use a strong random 64-char string in production)
JWT_SECRET=your_long_random_jwt_secret_here

# Frontend URL / Deployed Application URL (Used in WhatsApp confirmation ticket links)
# Example for Render: https://ai-cineaura.onrender.com
# Example for local development: http://localhost:5173
CLIENT_URL=http://localhost:5005

# Optional TMDB API Key (if using live poster/trailer sync)
TMDB_API_KEY=
